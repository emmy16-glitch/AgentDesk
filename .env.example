# Reown / WalletConnect project ID from https://dashboard.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Address printed by `npm run contract:deploy:testnet`
NEXT_PUBLIC_AGENTTRUST_MARKETPLACE_ADDRESS=

# 8004scan API key. Server-only. Anonymous discovery works at a much lower rate limit.
# Get a key from https://8004scan.io/developers/api-keys
SCAN8004_API_KEY=

# Camber CLI token (server-only; never use a NEXT_PUBLIC_ prefix)
CAMBER_TOKEN=

# Deployment only. Never expose this in NEXT_PUBLIC_* variables or source control.
DEPLOYER_PRIVATE_KEY=
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
