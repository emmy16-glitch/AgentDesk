# Reown / WalletConnect project ID from https://dashboard.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

# LEGACY PROTOTYPE ONLY.
# Address printed by `npm run contract:deploy:testnet` for the historical
# AgentTrustMarketplace BSC Testnet activation contract. This is NOT the future
# AgentDesk ERC-8183 / real agent-service hiring path.
NEXT_PUBLIC_AGENTTRUST_MARKETPLACE_ADDRESS=

# 8004scan API key. Server-only. Anonymous discovery works at a much lower rate limit.
# Get a key from https://8004scan.io/developers/api-keys
SCAN8004_API_KEY=

# Optional server-side BSC mainnet RPC override for direct ERC-8004 identity verification.
# Defaults to the public BNB Chain RPC when omitted.
BSC_MAINNET_RPC_URL=https://bsc-dataseed.binance.org

# Camber remote MCP uses OAuth. CAMBER_MCP_ACCESS_TOKEN is the only credential that
# may enable the Vercel remote-MCP path. Do not expose it to the browser.
# A manually supplied OAuth access token may expire; without a valid OAuth token,
# AgentDesk deliberately uses its deterministic evidence-engine fallback.
CAMBER_MCP_ACCESS_TOKEN=

# Camber CLI API key. Kept only for local/CLI workflows; it is NOT accepted as proof
# that the remote MCP endpoint is authenticated and does not enable Camber on Vercel.
CAMBER_API_KEY=

# Backwards-compatibility alias for an OAuth MCP bearer token in older deployments.
# Prefer CAMBER_MCP_ACCESS_TOKEN in new deployments.
CAMBER_TOKEN=

# AgentDesk Brain. If CAMBER_MCP_ACCESS_TOKEN is present and CAMBER_BRAIN_ENABLED is unset,
# the remote Camber path is enabled. Set false to force deterministic fallback only.
CAMBER_BRAIN_ENABLED=
CAMBER_BRAIN_AGENT_TAG=@emmanuel.Agentdesk-brain
CAMBER_BRAIN_MODEL=
CAMBER_MCP_URL=https://camber-mcp.cambercloud.com/mcp

# Legacy prototype contract deployment only. Never expose this in NEXT_PUBLIC_* variables or source control.
DEPLOYER_PRIVATE_KEY=
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
